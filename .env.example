# Copy to .env and fill in.
# Not required for CPU smoke runs.

# GCS bucket for orbax checkpoints (create it once, see docs/gcs_checkpoint_setup.md)
GCS_BUCKET=gs://vit-jax-checkpoints

# wandb (leave WANDB_MODE=offline to run without a real key)
WANDB_API_KEY=
WANDB_PROJECT=jax-vit-tpu
WANDB_MODE=online

# TPU-VM
TPU_NAME=vit-jax-v4-8
ZONE=us-central2-b
ACCELERATOR=v4-8

# jax cache dir on the TPU-VM (avoids recompiling on every run)
JAX_COMPILATION_CACHE_DIR=/home/tpu/.jax_cache
